#!/usr/bin/env bash
# bin/forge-build — Generic Forge v2 build pipeline.
#
# Reads tool-neutral sources from core/ and emits a single universal payload:
#   build/.agents/FORGE.md   — skill registry (<150 lines, <32 KiB); never the
#                              project's AGENTS.md, which holds the project's own rules
#   build/.agents/skills/    — Open Agent Skills standard path (Anthropic, Dec 2025;
#                              cross-tool standard since Jan 2026)
#   build/.agents/rules/     — full HARD RULES bodies linked from FORGE.md
#   build/scripts/           — runtime helpers from core/scripts/
#
# No <adapter> argument. No per-vendor builds. No adapter manifests. The output
# is the cross-tool standard. Agents read the project's own AGENTS.md natively
# (Claude Code v2.1.277+ included); FORGE.md is reference material only.
#
# Usage:
#   bin/forge-build                              build to ./build/
#   bin/forge-build --deploy <project>           build then copy outputs to <project>
#   bin/forge-build --deploy <project> --dry-run preview deploy without writing
#   bin/forge-build --help                       show this message
#
# See archive/maxima-pivot-plan.md for the architectural rationale.

set -euo pipefail

# --- Resolve paths ---
FORGE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="${BUILD_DIR:-$FORGE_ROOT/build}"

# --- Args ---
DEPLOY_TARGET=""
DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --deploy)
      DEPLOY_TARGET="${2:-}"
      if [[ -z "$DEPLOY_TARGET" ]]; then
        echo "ERROR: --deploy requires a project path" >&2; exit 1
      fi
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --help|-h)
      sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's|^# \{0,1\}||'
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      echo "Run 'bin/forge-build --help' for usage." >&2
      exit 1
      ;;
  esac
done

# --- Source dirs (sanity check) ---
SRC_SKILLS="$FORGE_ROOT/core/skills"
SRC_SCRIPTS="$FORGE_ROOT/core/scripts"
SRC_RULES="$FORGE_ROOT/core/rules"

for required in "$SRC_SKILLS" "$SRC_SCRIPTS" "$SRC_RULES"; do
  if [[ ! -d "$required" ]]; then
    echo "ERROR: required source directory missing: $required" >&2
    exit 1
  fi
done

echo "Generic Forge v2 build → $BUILD_DIR"
echo ""

# --- 1. Clean and recreate build dir ---
rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR/.agents/skills" "$BUILD_DIR/.agents/rules" "$BUILD_DIR/scripts"

# --- 2. Skills: copy core/skills/<name>/ → build/.agents/skills/<name>/ ---
SKILL_COUNT=0
for skill_dir in "$SRC_SKILLS"/*/; do
  [[ -d "$skill_dir" ]] || continue
  skill_name=$(basename "$skill_dir")
  cp -r "$skill_dir" "$BUILD_DIR/.agents/skills/"
  SKILL_COUNT=$((SKILL_COUNT + 1))
done
echo "  ✓ $SKILL_COUNT skills emitted to .agents/skills/"

# --- 3. Rules: copy core/rules/<name>.md → build/.agents/rules/<name>.md ---
RULE_COUNT=0
for rule_file in "$SRC_RULES"/*.md; do
  [[ -f "$rule_file" ]] || continue
  cp "$rule_file" "$BUILD_DIR/.agents/rules/"
  RULE_COUNT=$((RULE_COUNT + 1))
done
echo "  ✓ $RULE_COUNT rules emitted to .agents/rules/"

# --- 4. Scripts: copy core/scripts/*.sh → build/scripts/ ---
SCRIPT_COUNT=0
if compgen -G "$SRC_SCRIPTS"/*.sh > /dev/null; then
  cp "$SRC_SCRIPTS"/*.sh "$BUILD_DIR/scripts/"
  chmod +x "$BUILD_DIR/scripts"/*.sh
  SCRIPT_COUNT=$(ls "$BUILD_DIR/scripts/" | wc -l)
fi
echo "  ✓ $SCRIPT_COUNT scripts emitted to scripts/"

# --- 5. Compose .agents/FORGE.md (skill registry) ---
FORGE_MD="$BUILD_DIR/.agents/FORGE.md"

# Helper: extract first descriptive paragraph from a markdown file.
# Skips H1 heading, then captures the first content block (blockquote or paragraph),
# stripping leading "> " from blockquote lines.
first_paragraph() {
  awk '
    /^# / { next }
    /^## / { exit }
    /^[[:space:]]*$/ { if (p) exit; next }
    {
      sub(/^> ?/, "")
      print
      p=1
    }
  ' "$1"
}

# Helper: extract a frontmatter field (first occurrence)
frontmatter_field() {
  local file="$1" field="$2"
  awk -v field="$field" '
    /^---/ { f++; next }
    f == 1 && $0 ~ "^"field":" {
      sub("^"field": *", "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$file"
}

{
  cat <<HEADER
# Forge — Skill Registry

Forge is a tool-neutral knowledge + skills framework for AI coding agents. Skills (a.k.a. arts and masters) live in \`.agents/skills/<name>/SKILL.md\` per the [Open Agent Skills specification](https://agentskills.io/) (Anthropic, December 2025; cross-tool standard since January 2026). Most agents auto-discover them; some let you invoke explicitly via \`/<name>\` slash commands.

This file is the registry. Skill bodies live in \`skills/\`. HARD RULES live in \`rules/\`. (Paths are relative to this file, inside \`.agents/\`.)
HEADER

  # Rules pointers (first paragraph + link)
  echo ""
  echo "## Rules"
  echo ""
  for rule_file in "$SRC_RULES"/*.md; do
    [[ -f "$rule_file" ]] || continue
    rule_name=$(basename "$rule_file" .md)
    summary=$(first_paragraph "$rule_file" | head -2 | tr '\n' ' ' | sed 's/  */ /g' | sed 's/ *$//')
    echo "**${rule_name}** — ${summary}"
    echo ""
    echo "→ Full rules: [rules/${rule_name}.md](rules/${rule_name}.md)"
    echo ""
  done

  # Model-hint guidance
  cat <<MODELHINT
## Model selection

Each skill carries a neutral \`<!-- model: <tier> -->\` hint declaring the cognitive weight of its work. The tier is tool-agnostic; map it to your harness's nearest model:

| Hint | Meaning | Suggested model |
|---|---|---|
| \`model: haiku\` | Mechanical — scripts, polling, formatting | Your fastest / cheapest model |
| \`model: sonnet\` | Structured reasoning — evaluation against a rubric | A mid-tier balanced model |
| \`model: opus\` | High-judgment — orchestration, creative generation, synthesis, verdicts, reviewing sonnet output | Your strongest reasoning model |
| \`model: inherit\` | Rides the session — the skill runs at whatever model drives the conversation | Your current session model |

The full hint grammar is \`<!-- model: <tier> | fan-out: <leg> → <tier>; <leg> → <tier> -->\`. A \`fan-out:\` clause names the tier for each spawned leg; \`escalate:\` replaces it for conditional spawns — the stronger tier fires only when the named condition hits; single-agent skills end with \`| no fan-out\`. A fan-out note binds only where the skill's flow text names the tier at the spawn step — the hint is the summary, the flow text is the contract.

If your harness lacks parallel subagent spawning or per-spawn model selection, run the legs sequentially at your session model.

On Codex CLI / DeepSeek TUI / Gemini CLI, switch via \`/model\` before invoking a skill whose tier differs from your current model. (Claude Code applies the tier automatically — the hint is injected as real \`model:\` frontmatter at deploy time.)

MODELHINT

  # Skill registry table
  echo "## Skills"
  echo ""
  echo "| Skill | Description | Body |"
  echo "|---|---|---|"

  for skill_dir in "$SRC_SKILLS"/*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    skill_file="$skill_dir/SKILL.md"
    [[ -f "$skill_file" ]] || continue

    desc=$(frontmatter_field "$skill_file" "description")
    # Strip the "TRIGGER when:" suffix and trim
    short_desc=$(echo "$desc" | sed 's/ TRIGGER when:.*$//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    # Truncate to 100 chars to keep table tidy
    if [[ ${#short_desc} -gt 100 ]]; then
      short_desc="${short_desc:0:97}..."
    fi
    [[ -z "$short_desc" ]] && short_desc="—"

    echo "| /${skill_name} | ${short_desc} | [skills/${skill_name}/SKILL.md](skills/${skill_name}/SKILL.md) |"
  done

  # Footer
  cat <<FOOTER

---

Generic Forge v2. Built from [forge-arcana/forge](https://github.com/forge-arcana/forge). See \`archive/maxima-pivot-plan.md\` for the architecture rationale.

Claude Code (v2.1.277+) and other agents read the project's \`AGENTS.md\` natively; this registry is reference material and is not auto-loaded by Claude Code.
FOOTER
} > "$FORGE_MD"

# --- 6. Validate FORGE.md size ---
forge_bytes=$(wc -c < "$FORGE_MD")
forge_lines=$(wc -l < "$FORGE_MD")
echo "  ✓ .agents/FORGE.md composed (${forge_lines} lines, ${forge_bytes} bytes)"

if [[ $forge_bytes -gt 32768 ]]; then
  echo "  ⚠ FORGE.md exceeds Codex's 32 KiB project_doc_max_bytes cap (${forge_bytes} bytes)" >&2
  echo "     Trim required — consider further progressive disclosure." >&2
fi
if [[ $forge_lines -gt 150 ]]; then
  echo "  ⚠ FORGE.md exceeds 150-line target (${forge_lines} lines)" >&2
fi

echo ""
echo "Built: $BUILD_DIR"

# --- 7. Deploy if requested ---
if [[ -n "$DEPLOY_TARGET" ]]; then
  DEPLOY_TARGET=$(cd "$DEPLOY_TARGET" 2>/dev/null && pwd) || {
    echo "ERROR: deploy target does not exist: $DEPLOY_TARGET" >&2
    exit 1
  }

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo ""
    echo "DRY-RUN: would deploy:"
    echo "  $BUILD_DIR/.agents/FORGE.md    → $DEPLOY_TARGET/.agents/FORGE.md"
    echo "  $BUILD_DIR/.agents/skills/*/   → $DEPLOY_TARGET/.agents/skills/<name>/  (each forge skill replaced; other dirs untouched)"
    echo "  $BUILD_DIR/.agents/rules/*.md  → $DEPLOY_TARGET/.agents/rules/         (same-named files overwritten; others untouched)"
    echo "  $BUILD_DIR/scripts/*.sh        → $DEPLOY_TARGET/scripts/               (same-named files overwritten; others untouched)"
    exit 0
  fi

  echo ""
  echo "Deploying to $DEPLOY_TARGET ..."

  mkdir -p "$DEPLOY_TARGET/.agents"
  cp "$BUILD_DIR/.agents/FORGE.md" "$DEPLOY_TARGET/.agents/FORGE.md"

  # Additive deploy: replace only forge-owned items; never remove a project's own files.
  mkdir -p "$DEPLOY_TARGET/.agents/skills" "$DEPLOY_TARGET/.agents/rules" "$DEPLOY_TARGET/scripts"

  for skill_dir in "$BUILD_DIR/.agents/skills"/*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    rm -rf "$DEPLOY_TARGET/.agents/skills/$skill_name"
    cp -r "$skill_dir" "$DEPLOY_TARGET/.agents/skills/$skill_name"
  done

  for rule_file in "$BUILD_DIR/.agents/rules"/*.md; do
    [[ -f "$rule_file" ]] || continue
    cp "$rule_file" "$DEPLOY_TARGET/.agents/rules/$(basename "$rule_file")"
  done

  for script_file in "$BUILD_DIR/scripts"/*.sh; do
    [[ -f "$script_file" ]] || continue
    cp "$script_file" "$DEPLOY_TARGET/scripts/$(basename "$script_file")"
  done

  echo "  ✓ .agents/FORGE.md, .agents/skills/, .agents/rules/, scripts/ deployed (additive; project files untouched)"

  if [[ -f "$DEPLOY_TARGET/AGENTS.md" ]] && [[ "$(head -n 1 "$DEPLOY_TARGET/AGENTS.md")" == "# Forge — Agent Instructions" ]]; then
    {
      echo ""
      echo "WARNING: $DEPLOY_TARGET/AGENTS.md is a STALE generated forge registry (older forge-build versions wrote it there)."
      echo "  Agents now load it as the project's rules. The registry lives at .agents/FORGE.md."
      echo "  Replace AGENTS.md with the project's own rules (running /forge in the project will flag it). The file was not modified."
    } >&2
  elif [[ ! -f "$DEPLOY_TARGET/AGENTS.md" ]] || ! grep -q '\.agents/FORGE\.md' "$DEPLOY_TARGET/AGENTS.md"; then
    echo ""
    echo "Hint: add a pointer line to the project's AGENTS.md, e.g. \"Forge skill registry: .agents/FORGE.md\" (AGENTS.md was not modified)."
  fi
fi
